{
	"name": "my-project",
	"org": "YOUR_ORG", "repo": "YOUR_REPO",
	"tokenFile": "~/.config/YOUR_TOKEN_FILE",
	"board": { "projectNumber": 1, "owner": "YOUR_ORG" },
