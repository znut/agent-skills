{
	"name": "my-project",
	"org": "YOUR_ORG", "repo": "YOUR_REPO",
	"tokenFile": "~/.config/YOUR_TOKEN_FILE",
	"board": { "projectNumber": 1, "owner": "YOUR_ORG" },
	"mainHealth": {
		"repo": "~/src/your-repo",
		"steps": [
			{ "name": "install", "cmd": "bun install --frozen-lockfile" },
			{ "name": "check", "cmd": "bun run check" },
			{ "name": "lint", "cmd": "bun run lint" },
			{ "name": "test", "cmd": "bun run test" }
		],
		"env": { "CI": "1" },
		"skipPattern": "^docs/|\\.md$",
		"stepTimeout": 1800
	},
	"onMerge": [
		{ "type": "board-snapshot" },
		{ "type": "command", "cmd": "bash scripts/cleanup-worktrees.sh --apply", "cwd": "~/src/your-repo" },
		{ "type": "command", "cmd": "bash ~/src/agent-skills/tools/main-health/main-health.sh my-project", "cwd": "~/src/your-repo" }
	]
}
