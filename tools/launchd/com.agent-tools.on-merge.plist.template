<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PATH is rendered by tools/install.sh from the resolved bun, node, and
	     gh locations; never hardcode an install prefix here. -->
	<key>Label</key><string>com.agent-tools.on-merge</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BUN__</string>
		<string>__TOOLS_DIR__/on-merge/run.mjs</string>
		<string>__CONFIG_NAME__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key><string>__PATH__</string>
		<key>AGENT_TOOLS_HOME</key><string>__AGENT_TOOLS_HOME__</string>
	</dict>
	<key>WorkingDirectory</key><string>__TOOLS_DIR__/on-merge</string>
	<!-- No ProcessType=Background: DARWIN_BG starves the child tree under
	     sustained interactive load. main-health's per-step nice -n 19 already
	     yields to real work. -->
	<key>WatchPaths</key>
	<array>
		<string>__VAR_DIR__/__CONFIG_NAME__/gh-status/events</string>
	</array>
	<key>StandardOutPath</key><string>__VAR_DIR__/on-merge-watch.log</string>
	<key>StandardErrorPath</key><string>__VAR_DIR__/on-merge-watch.log</string>
</dict>
</plist>
