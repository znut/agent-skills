<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- See com.agent-tools.gh-status.plist.template for the PATH note — this
	     watcher's on-merge steps shell out to board-snapshot (needs `gh`) and
	     arbitrary "command" steps, so both bun's and gh's directories must be
	     in PATH here too. -->
	<key>Label</key><string>com.agent-tools.on-merge</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BUN__</string>
		<string>__TOOLS_DIR__/on-merge/run.mjs</string>
		<string>__CONFIG_NAME__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key><string>__PATH__</string>
		<key>AGENT_TOOLS_HOME</key><string>__AGENT_TOOLS_HOME__</string>
	</dict>
	<key>WorkingDirectory</key><string>__TOOLS_DIR__/on-merge</string>
	<!-- Deliberately NO ProcessType=Background here (and the currently-
	     installed plist on this machine never had it either — this comment
	     just makes that permanent instead of accidental). ProcessType
	     Background maps to Darwin's DARWIN_BG QoS class, a hard scheduler
	     throttle rather than a proportional deprioritization: on a machine
	     that's continuously near its core count in interactive load (many
	     parallel worker sessions is the normal state here, not an edge case),
	     DARWIN_BG starves the whole child tree to a near-zero CPU duty cycle
	     indefinitely instead of merely yielding to real work — confirmed
	     live via main-health.sh's own now-removed `taskpolicy -b` step QoS,
	     which is the same mechanism (#2120). Per-step `nice -n 19` inside
	     main-health.sh already provides the "lose CPU contests to real work"
	     behavior without that catastrophic-starvation failure mode; this job
	     itself (mostly idle, waiting on WatchPaths) doesn't need backgrounding
	     at the plist level too. -->
	<key>WatchPaths</key>
	<array>
		<string>__VAR_DIR__/__CONFIG_NAME__/gh-status/events</string>
	</array>
	<key>StandardOutPath</key><string>__VAR_DIR__/on-merge-watch.log</string>
	<key>StandardErrorPath</key><string>__VAR_DIR__/on-merge-watch.log</string>
</dict>
</plist>
