#!/bin/sh
# bgh — per-clone-identity gh wrapper. Resolves the current repo's configured
# identity and execs gh as it: a bot token when the clone declares one, or the
# human's own gh login when the clone opts into personal identity. Repo
# scripts call bgh unconditionally either way — identity is the CLONE's
# choice, never the call site's.
#
# Per-repo config (machine-local .git/config — never committed, and shared by
# every worktree of the repo). Exactly one of:
#   git config agent.bot-token-file '~/.config/<bot>.token'   # bot identity
#   git config agent.gh-identity personal                     # own gh login
# One-call override: BGH_TOKEN_FILE=<path> bgh …
set -eu

tf=${BGH_TOKEN_FILE:-$(git config --get agent.bot-token-file 2>/dev/null || true)}
if [ -z "$tf" ]; then
	ident=$(git config --get agent.gh-identity 2>/dev/null || true)
	if [ "$ident" = "personal" ]; then
		# Personal mode: plain gh with the user's own auth (gh auth login).
		# Same self-log contract as the bot path, for watcher self-echo skip.
		if [ -n "${BGH_SELF_LOG:-}" ]; then
			rc=0
			out=$(gh "$@") || rc=$?
			[ -n "$out" ] && printf '%s\n' "$out"
			{
				printf '%s\n' "$out" | grep -oE '#issuecomment-[0-9]+' | grep -oE '[0-9]+'
				printf '%s\n' "$out" | grep -oE 'discussion_r[0-9]+' | grep -oE '[0-9]+'
				printf '%s\n' "$out" | grep -oE '"id": ?[0-9]+' | head -1 | grep -oE '[0-9]+'
				printf '%s\n' "$out" | grep -xE '[0-9]{6,}'
			} 2>/dev/null | sort -u >> "$BGH_SELF_LOG" || true
			exit $rc
		fi
		exec gh "$@"
	fi
	echo 'bgh: no identity configured for this repo.' >&2
	echo "  bot:       git config agent.bot-token-file '~/.config/<bot>.token'" >&2
	echo '  personal:  git config agent.gh-identity personal   (uses your own `gh auth login`)' >&2
	exit 1
fi
case $tf in
	"~/"*) tf=$HOME/${tf#"~/"} ;;
esac
if [ ! -r "$tf" ]; then
	echo "bgh: token file not readable: $tf" >&2
	exit 1
fi
# Self-event capture: BGH_SELF_LOG=<file> appends the ids of comments/reviews
# this call CREATED, so the session's watcher can skip its own echoes
# (gh-status timeline events carry the same id). Explicit env always wins.
#
# Auto-derivation: when BGH_SELF_LOG is unset AND the call is
# posting-shaped, derive <agent.self-events-dir>/<role>.ids from the session
# role marker — posting discipline without per-call env. Gated to
# posting-shaped calls ONLY: the id-scrape run on a READ (e.g. `bgh api
# .../comments`) would capture a STRANGER's comment id, and the watcher would
# then swallow that real event as a self-echo. Subagent shells share the
# session id, so a worker's posts log to its orchestrator's role file — the
# session's own watcher correctly skips them. Fast path when neither explicit
# nor derivable: plain exec, zero overhead.
if [ -z "${BGH_SELF_LOG:-}" ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
	posting=""
	case " $* " in
		*" pr comment "*|*" issue comment "*|*" pr review "*) posting=1 ;;
		*" api "*)
			case " $* " in
				*" --method POST "*|*" -X POST "*|*" --method PATCH "*|*" -X PATCH "*)
					case " $* " in *comments*|*reviews*) posting=1 ;; esac ;;
			esac ;;
	esac
	if [ -n "$posting" ]; then
		case ${CLAUDE_CODE_SESSION_ID} in
			*/*|*..*) ;; # path-unsafe session id: skip derivation
			*)
				sev_dir=$(git config --get agent.self-events-dir 2>/dev/null || true)
				role=$(cat "/tmp/cc-session-roles/${CLAUDE_CODE_SESSION_ID}" 2>/dev/null || true)
				if [ -n "$sev_dir" ] && [ -n "$role" ]; then
					case $sev_dir in "~/"*) sev_dir=$HOME/${sev_dir#"~/"} ;; esac
					mkdir -p "$sev_dir" 2>/dev/null && BGH_SELF_LOG="$sev_dir/$role.ids"
				fi ;;
		esac
	fi
fi
if [ -n "${BGH_SELF_LOG:-}" ]; then
	rc=0
	out=$(GH_TOKEN=$(cat "$tf") gh "$@") || rc=$?
	[ -n "$out" ] && printf '%s\n' "$out"
	{
		printf '%s\n' "$out" | grep -oE '#issuecomment-[0-9]+' | grep -oE '[0-9]+'
		printf '%s\n' "$out" | grep -oE 'discussion_r[0-9]+' | grep -oE '[0-9]+'
		printf '%s\n' "$out" | grep -oE '"id": ?[0-9]+' | head -1 | grep -oE '[0-9]+'
		printf '%s\n' "$out" | grep -xE '[0-9]{6,}'
	} 2>/dev/null | sort -u >> "$BGH_SELF_LOG" || true
	exit $rc
fi
GH_TOKEN=$(cat "$tf") exec gh "$@"
