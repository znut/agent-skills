#!/bin/sh
# bgh — per-clone-identity gh wrapper. Runs gh as the identity the clone
# declares: a bot token when the clone sets one, the user's own gh login when
# it opts into personal identity. Repo scripts call bgh unconditionally;
# identity is the clone's choice, never the call site's. Installed as `gh`
# ahead of the real binary on PATH, it makes every gh call in a clone use
# that clone's identity, the way a per-repo tool-version file picks a runtime.
#
# Per-repo config (machine-local .git/config, shared by every worktree).
# Exactly one of:
#   git config agent.bot-token-file '~/.config/<bot>.token'   # bot identity
#   git config agent.gh-identity personal                     # own gh login
# One-call override: BGH_TOKEN_FILE=<path> bgh …
# A preset GH_TOKEN, or a directory outside any git repo, runs the real gh
# unchanged: the caller chose the identity, or there is no clone to ask.
set -eu

# The real gh: the first executable named gh on PATH that is not this script.
self=$(realpath "$0" 2>/dev/null || printf '%s' "$0")
real_gh=""
old_ifs=$IFS
IFS=:
for d in $PATH; do
	c="$d/gh"
	[ -x "$c" ] || continue
	[ "$c" -ef "$self" ] && continue
	real_gh=$c
	break
done
IFS=$old_ifs
[ -n "$real_gh" ] || { echo 'bgh: no gh binary on PATH' >&2; exit 1; }

# With BGH_SELF_LOG set, append the ids of the comments and reviews this call
# created, so the session's watcher can skip its own echoes (gh-status
# timeline events carry the same id). Exits with gh's status.
run_logged() {
	rc=0
	out=$("$real_gh" "$@") || rc=$?
	[ -n "$out" ] && printf '%s\n' "$out"
	{
		printf '%s\n' "$out" | grep -oE '#issuecomment-[0-9]+' | grep -oE '[0-9]+'
		printf '%s\n' "$out" | grep -oE 'discussion_r[0-9]+' | grep -oE '[0-9]+'
		printf '%s\n' "$out" | grep -oE '"id": ?[0-9]+' | head -1 | grep -oE '[0-9]+'
		printf '%s\n' "$out" | grep -xE '[0-9]{6,}'
	} 2>/dev/null | sort -u >> "$BGH_SELF_LOG" || true
	exit $rc
}

# Ready check: `pr ready <n>` (not --undo) first runs the clone's declared
# check, `git config agent.ready-check '<command>'`, as `<command> <n>` from
# the repo root, and refuses when it fails. The clone decides what ready
# needs (a green gate result, a review verdict); bgh only holds the door.
case " $* " in
	*" pr ready "*)
		case " $* " in
			*" --undo "*) ;;
			*)
				check=$(git config --get agent.ready-check 2>/dev/null || true)
				if [ -n "$check" ]; then
					n=""
					for a in "$@"; do case $a in [0-9]*) n=$a; break ;; esac; done
					top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
					if ! (cd "$top" && sh -c "$check \"\$1\"" bgh "$n"); then
						echo "bgh: ready check failed for PR ${n:-<current branch>}; not marking ready" >&2
						exit 1
					fi
				fi ;;
		esac ;;
esac

[ -n "${GH_TOKEN:-}" ] && exec "$real_gh" "$@"
git rev-parse --git-dir >/dev/null 2>&1 || exec "$real_gh" "$@"

tf=${BGH_TOKEN_FILE:-$(git config --get agent.bot-token-file 2>/dev/null || true)}
if [ -z "$tf" ]; then
	ident=$(git config --get agent.gh-identity 2>/dev/null || true)
	if [ "$ident" = "personal" ]; then
		[ -n "${BGH_SELF_LOG:-}" ] && run_logged "$@"
		exec "$real_gh" "$@"
	fi
	echo 'bgh: no identity configured for this repo.' >&2
	echo "  bot:       git config agent.bot-token-file '~/.config/<bot>.token'" >&2
	echo '  personal:  git config agent.gh-identity personal   (uses your own `gh auth login`)' >&2
	exit 1
fi
case $tf in
	"~/"*) tf=$HOME/${tf#"~/"} ;;
esac
if [ ! -r "$tf" ]; then
	echo "bgh: token file not readable: $tf" >&2
	exit 1
fi
# Derive BGH_SELF_LOG for posting-shaped calls only (pr/issue comment, pr
# review, api POST/PATCH on comments or reviews): scraping a READ would log a
# stranger's comment id and the watcher would swallow that real event. The
# role comes from the marker boot-report writes for the session, the dir from
# `git config agent.self-events-dir`. An explicit BGH_SELF_LOG always wins.
#
# A named session's watcher reads its OWN per-generation self-events dir, not
# the shared role dir, so a matching `agent-session current` registration
# wins over the role-based dir; any lookup trouble falls back to it instead.
if [ -z "${BGH_SELF_LOG:-}" ]; then
	posting=""
	case " $* " in
		*" pr comment "*|*" issue comment "*|*" pr review "*) posting=1 ;;
		*" api "*)
			case " $* " in
				*" --method POST "*|*" -X POST "*|*" --method PATCH "*|*" -X PATCH "*)
					case " $* " in *comments*|*reviews*) posting=1 ;; esac ;;
			esac ;;
	esac
	if [ -n "$posting" ]; then
		derive_session_id=""
		role_marker_dir=""
		if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
			derive_session_id=${CLAUDE_CODE_SESSION_ID}
			role_marker_dir="/tmp/cc-session-roles"
		elif [ -n "${PI_SESSION_ID:-}" ]; then
			derive_session_id=${PI_SESSION_ID}
			role_marker_dir="/tmp/pi-session-roles"
		elif [ -n "${CODEX_THREAD_ID:-}" ]; then
			derive_session_id=${CODEX_THREAD_ID}
			role_marker_dir="/tmp/codex-session-roles"
		fi
		if [ -n "$derive_session_id" ]; then
			case $derive_session_id in
				*/*|*..*) ;; # path-unsafe session id: skip derivation
				*)
					sev_dir=$(git config --get agent.self-events-dir 2>/dev/null || true)
					role=$(cat "${role_marker_dir}/${derive_session_id}" 2>/dev/null || true)
					if [ -n "$sev_dir" ] && [ -n "$role" ]; then
						case $sev_dir in "~/"*) sev_dir=$HOME/${sev_dir#"~/"} ;; esac
						# Ask the registry for THIS session's named registration; a
						# match wins with its own self-events dir, bounded and
						# stdin-safe so a stuck lookup never blocks the gh call.
						named_dir=""
						tool=${AGENT_SESSION_TOOL:-}
						[ -n "$tool" ] || tool=$(command -v agent-session 2>/dev/null || true)
						if [ -z "$tool" ]; then
							sib=$(dirname "$self")/../agent-session
							[ -x "$sib" ] && tool=$sib || true
						fi
						if [ -n "$tool" ]; then
							# A pipe (command substitution) blocks on any grandchild
							# the timed-out tool leaves holding stdout open; a plain
							# temp file has no such reader-side wait.
							named_out=$(mktemp 2>/dev/null) || named_out="/tmp/bgh-self-log.$$"
							perl -e 'alarm($ARGV[0]); exec(@ARGV[1..$#ARGV]) or exit 1;' -- 3 "$tool" current </dev/null >"$named_out" 2>/dev/null || true
							named_json=$(cat "$named_out" 2>/dev/null || true)
							rm -f "$named_out"
							if [ -n "$named_json" ]; then
								named_dir=$(printf '%s' "$named_json" | jq -r --arg role "$role" '
									(if .session.role == "pm" then "pm" else "tl-" + (.session.lane // "") end) as $expected
									| if $expected == $role then (.session.paths.self_events // "") else "" end
								' 2>/dev/null || true)
								case $named_dir in /*) ;; *) named_dir="" ;; esac
							fi
						fi
						if [ -n "$named_dir" ]; then
							mkdir -p "$named_dir" 2>/dev/null && BGH_SELF_LOG="$named_dir/$role.ids"
						else
							mkdir -p "$sev_dir" 2>/dev/null && BGH_SELF_LOG="$sev_dir/$role.ids"
						fi
					fi ;;
			esac
		fi
	fi
fi
GH_TOKEN=$(cat "$tf")
export GH_TOKEN
[ -n "${BGH_SELF_LOG:-}" ] && run_logged "$@"
exec "$real_gh" "$@"
